# Environment variables read by the tests.
# Nothing loads this file automatically: set these in your terminal
# (for example in PowerShell: $env:ENVIRONMENT="test") or in
# .vscode/settings.json under "playwright.env". Never put secrets here.

# The CDP environment to test, for example: test
# Leave blank to test services running locally. "prod" is refused.
ENVIRONMENT=

# Which tests run: importer, inspector or default.
# Add :e2e to a domain (for example importer:e2e) as CDP does.
# Leave blank to run every test.
PROFILE=

# Set by CDP when it runs the container. You never set these locally.
# RUN_ID
# RESULTS_OUTPUT_S3_PATH
# HTTP_PROXY
